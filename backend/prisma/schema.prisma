generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN
  PRODUTOR
}

enum StatusMaquina {
  DISPONIVEL
  MANUTENCAO
  INATIVA
}

enum StatusReserva {
  ATIVA
  CANCELADA
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(100)
  email     String    @unique @db.VarChar(150)
  senhaHash String    @map("senha_hash")
  perfil    Perfil    @default(PRODUTOR)
  criadoEm  DateTime  @default(now()) @map("criado_em")
  reservas  Reserva[]

  @@map("usuarios")
}

model Maquina {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique @db.VarChar(20)
  nome         String        @db.VarChar(100)
  categoria    String        @db.VarChar(40)
  marca        String        @db.VarChar(60)
  ano          Int
  valorDiaria  Decimal       @map("valor_diaria") @db.Decimal(10, 2)
  descricao    String?       @db.VarChar(500)
  status       StatusMaquina @default(DISPONIVEL)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  reservas     Reserva[]

  @@map("maquinas")
}

model Reserva {
  id           Int           @id @default(autoincrement())
  maquinaId    Int           @map("maquina_id")
  usuarioId    Int           @map("usuario_id")
  dataInicio   DateTime      @map("data_inicio") @db.Date
  dataFim      DateTime      @map("data_fim") @db.Date
  propriedade  String        @db.VarChar(120)
  finalidade   String        @db.VarChar(300)
  valorTotal   Decimal       @map("valor_total") @db.Decimal(12, 2)
  status       StatusReserva @default(ATIVA)
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")
  maquina      Maquina       @relation(fields: [maquinaId], references: [id], onDelete: Restrict)
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([maquinaId, dataInicio, dataFim])
  @@index([usuarioId])
  @@map("reservas")
}
