# Copie este arquivo para .env e preencha. O .env nunca vai para o repositório.

# Endereço do PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=

# Segredo do JWT, com no mínimo 32 caracteres. Para gerar um:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

PORT=3333

# Endereços do frontend autorizados a chamar a API (separados por vírgula)
CORS_ORIGIN=http://localhost:5173

# Administrador criado pelo seed (senha com no mínimo 8 caracteres)
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
