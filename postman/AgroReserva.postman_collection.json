    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastrar Ana",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dia = (n) => new Date(Date.now() - 3 * 36e5 + n * 864e5).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('sufixo', Date.now());",
                  "pm.collectionVariables.set('d1', dia(5));",
                  "pm.collectionVariables.set('d2', dia(8));",
                  "pm.collectionVariables.set('d3', dia(9));",
                  "pm.collectionVariables.set('d4', dia(10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('tokenAna', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/cadastro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Lima\",\n  \"email\": \"ana{{sufixo}}@teste.test\",\n  \"senha\": \"{{senhaTeste}}\"\n}",
